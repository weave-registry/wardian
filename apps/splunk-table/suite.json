{
  "$schema": "http://127.0.0.1:8000/schemas/suite.schema.json",
  "format": 2,
  "title": "Splunk table",
  "description": "Run a Splunk search and see every row it returns. Other apps, such as the USL lab, can use the table.",
  "styles": [
    "ui/theme.css",
    "ui/button.css",
    "ui/field.css",
    "ui/card.css",
    "ui/table.css",
    "ui/switch.css",
    "ui/receipt.css",
    "ui/type.css",
    "ui/surface.css",
    "style.css"
  ],
  "scripts": [
    "ui/receipt.js",
    "shared/cells.js",
    "shared/find.js",
    "shared/range.js",
    "shared/saved.js",
    "shared/sample.js",
    "shared/usl.js"
  ],
  "surface": "glass",
  "apps": [
    {
      "name": "search",
      "slot": "aside",
      "wrap": "<aside class=\"w-card w-glass panel\">",
      "scripts": [
        "apps/search/presets.js",
        "apps/search/form.js"
      ],
      "emits": {
        "table:ready": {
          "retain": true
        }
      },
      "listens": [
        "search:use",
        "table:ready"
      ],
      "caps": [
        "storage",
        "splunk",
        "db"
      ]
    },
    {
      "name": "ask",
      "slot": "aside",
      "wrap": "<aside class=\"w-card w-glass panel\">",
      "emits": {
        "search:use": {}
      },
      "listens": [
        "ai:step"
      ],
      "needs": [
        "ai.status",
        "ai.write"
      ]
    },
    {
      "name": "about",
      "slot": "main",
      "wrap": "<section class=\"w-card w-glass panel\">",
      "listens": [
        "table:ready"
      ],
      "caps": [
        "db"
      ]
    },
    {
      "name": "rows",
      "slot": "main",
      "wrap": "<section class=\"w-card w-glass panel\">",
      "emits": {
        "table:view": {
          "retain": true
        }
      },
      "listens": [
        "table:ready"
      ],
      "caps": [
        "db"
      ]
    },
    {
      "name": "keep",
      "slot": "main",
      "wrap": "<section class=\"w-card w-glass panel\">",
      "emits": {
        "table:ready": {
          "retain": true
        }
      },
      "listens": [
        "table:ready",
        "table:view"
      ],
      "caps": [
        "storage",
        "db",
        "claude:downloads"
      ],
      "channels": {
        "send": [
          "splunk.table"
        ]
      }
    },
    {
      "name": "ai",
      "scripts": [
        "ui/agent.js"
      ],
      "emits": {
        "ai:step": {}
      },
      "provides": [
        "status",
        "write",
        "chat"
      ],
      "caps": [
        "claude:sample",
        "asset",
        "splunk",
        "db"
      ]
    }
  ]
}
