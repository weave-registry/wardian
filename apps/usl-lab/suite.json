{
  "format": 2,
  "title": "USL scalability lab",
  "description": "Fit load-test results to the Universal Scalability Law and test changes before you build them.",
  "styles": [
    "ui/theme.css",
    "ui/button.css",
    "ui/field.css",
    "ui/card.css",
    "ui/badge.css",
    "ui/table.css",
    "ui/tooltip.css",
    "ui/receipt.css",
    "core/style.css"
  ],
  "scripts": [
    "ui/progress.js",
    "ui/tooltip.js",
    "ui/receipt.js",
    "core/lib.js"
  ],
  "header": "core/header.html",
  "apps": [
    {
      "name": "engine",
      "scripts": [
        "core/engine.js"
      ],
      "emits": {
        "engine:status": {
          "retain": true
        }
      },
      "provides": [
        "analyze",
        "curve"
      ],
      "caps": [
        "worker",
        "source"
      ]
    },
    {
      "name": "session",
      "emits": {
        "analysis:ready": {
          "retain": true
        }
      },
      "listens": [
        "data:changed",
        "engine:status"
      ],
      "needs": [
        "engine.analyze"
      ]
    },
    {
      "name": "inputs",
      "slot": "aside",
      "wrap": "<aside class=\"inputs\" aria-label=\"Inputs\">",
      "emits": {
        "data:changed": {
          "retain": true
        },
        "context:changed": {
          "retain": true
        }
      },
      "caps": [
        "storage",
        "db"
      ],
      "channels": {
        "receive": [
          "splunk.table"
        ]
      }
    },
    {
      "name": "chart",
      "slot": "main",
      "wrap": "<section class=\"w-card lab-card\" id=\"chartSec\" aria-labelledby=\"chartTitle\">",
      "listens": [
        "analysis:ready",
        "whatif:changed",
        "target:changed",
        "engine:status"
      ],
      "needs": [
        "engine.curve"
      ]
    },
    {
      "name": "meaning",
      "slot": "main",
      "wrap": "<section class=\"w-card lab-card\" id=\"meanSec\" aria-labelledby=\"meanTitle\">",
      "emits": {
        "target:changed": {
          "retain": true
        }
      },
      "listens": [
        "analysis:ready",
        "checks:ready"
      ],
      "caps": [
        "storage"
      ]
    },
    {
      "name": "whatif",
      "slot": "main",
      "wrap": "<section class=\"w-card lab-card\" id=\"whatifSec\" aria-labelledby=\"wiTitle\">",
      "emits": {
        "whatif:changed": {
          "retain": true
        }
      },
      "listens": [
        "analysis:ready",
        "capability:ai"
      ],
      "needs": [
        "diagnosis.parseWhatIf"
      ]
    },
    {
      "name": "readouts",
      "slot": "main",
      "wrap": "<section class=\"w-card lab-card\" id=\"fitSec\" aria-labelledby=\"fitTitle\">",
      "listens": [
        "analysis:ready"
      ]
    },
    {
      "name": "checks",
      "slot": "main",
      "wrap": "<section class=\"w-card lab-card\" id=\"checksSec\" aria-labelledby=\"chkTitle\">",
      "emits": {
        "checks:ready": {
          "retain": true
        }
      },
      "listens": [
        "analysis:ready"
      ]
    },
    {
      "name": "diagnosis",
      "slot": "main",
      "wrap": "<section class=\"w-card lab-card\" id=\"aiSec\" aria-labelledby=\"aiTitle\" hidden>",
      "emits": {
        "capability:ai": {
          "retain": true
        },
        "diagnosis:updated": {
          "retain": true
        }
      },
      "listens": [
        "analysis:ready",
        "checks:ready",
        "context:changed"
      ],
      "provides": [
        "parseWhatIf"
      ],
      "caps": [
        "claude:sample"
      ]
    },
    {
      "name": "export",
      "slot": "main",
      "wrap": "<section class=\"w-card lab-card\" id=\"exportSec\" aria-labelledby=\"expTitle\">",
      "listens": [
        "analysis:ready",
        "whatif:changed",
        "checks:ready",
        "diagnosis:updated",
        "context:changed",
        "capability:ai",
        "engine:status"
      ],
      "needs": [
        "engine.curve"
      ],
      "caps": [
        "claude:downloads"
      ]
    }
  ]
}
